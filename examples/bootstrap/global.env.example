# ~/.eurus/.env — global environment file managed by `eurus bootstrap`
# Created automatically by `eurus bootstrap --quick` or `eurus setup provider`.
# Permissions are tightened to 0600; values are written with atomic file replacement.
# Fill in only what you use; empty values are placeholders and safe to leave.

# Provider API keys (exactly one is needed for the default model you configure)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Telegram gateway (see `eurus setup telegram`)
EURUS_TELEGRAM_BOT_TOKEN=
EURUS_TELEGRAM_ALLOWED_USER_IDS=

# Local model runtime (Ollama); no API key required
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional provider overrides (custom endpoints)
NVIDIA_BASE_URL=

# Runtime overrides (all optional; prefer config.toml for permanent settings)
EURUS_MODEL=
EURUS_FALLBACK=
EURUS_PERMISSION_MODE=
EURUS_LOG_LEVEL=
EURUS_TIMEOUT=
EURUS_MAX_RETRIES=
EURUS_LOCAL_ONLY=
